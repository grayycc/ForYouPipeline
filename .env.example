# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# Bedrock API key (AWS console -> Bedrock -> API keys).
AWS_BEARER_TOKEN=

# Region the inference profiles are served from, e.g. ap-southeast-1
AWS_REGION=

# One inference profile per role. List what your account can invoke with
# boto3.client('bedrock').list_inference_profiles(); current-generation Claude models are
# published under the "global." prefix. These are all Claude models differing in capability
# rather than task specialisation, so choose by how hard each role's job is.

# Decides the next experiment; the highest-value reasoning call, and the only one that
# searches the literature.
AGENT_PLANNER_MODEL=

# Write a whole training file from scratch. A weaker model here was measured emitting prose
# inside the code fence, producing a file that would not parse.
AGENT_BASELINE_MODEL=
AGENT_EDA_MODEL=
AGENT_CODER_MODEL=

# Reads code for one named defect (label leakage). A narrow classification job.
AGENT_REVIEWER_MODEL=

# First fix attempt on a failed node, then the escalation when that fix also fails.
AGENT_DEBUGGER_MODEL=
AGENT_DEBUGGER_RETRY_MODEL=

# Optional: contact address sent to OpenAlex, which grants better rate limits.
OPENALEX_MAILTO=
